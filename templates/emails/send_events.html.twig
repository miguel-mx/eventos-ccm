<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seminarios CCM</title>
    <style>
        @media only screen and (max-width: 620px) {
            .email-container { width: 100% !important; }
            .email-body { padding: 24px 16px !important; }
            .event-title { font-size: 17px !important; }
        }
    </style>
</head>
<body style="margin:0;padding:0;background:#f5f4f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f4f2;padding:32px 0;">
<tr><td align="center">

<table class="email-container" width="600" cellpadding="0" cellspacing="0"
       style="max-width:600px;width:100%;background:#ffffff;border-radius:4px;overflow:hidden;">

    {# ── Header ── #}
    <tr>
        <td style="background:#ffffff;padding:0;">
            <table width="100%" cellpadding="0" cellspacing="0">
                <tr><td style="background:#b25828;height:4px;font-size:0;line-height:0;">&nbsp;</td></tr>
                <tr>
                    <td style="padding:28px 40px 20px;">
                        <p style="margin:0 0 6px;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#999999;">
                            Centro de Ciencias Matemáticas &middot; UNAM
                        </p>
                        <h1 style="margin:0;font-size:22px;font-weight:700;color:#1a1a1a;line-height:1.2;">
                            Seminarios
                        </h1>
                        <p style="margin:4px 0 0;font-size:13px;color:#777777;">
                            Semana del {{ startOfWeek|format_datetime(pattern="d", locale='es') }}
                            al {{ endOfWeek|format_datetime(pattern="d 'de' MMMM 'de' yyyy", locale='es') }}
                        </p>
                    </td>
                </tr>
                <tr><td style="padding:0 40px;"><hr style="border:none;border-top:1px solid #e5e4e2;margin:0;"></td></tr>
            </table>
        </td>
    </tr>

    {# ── Events ── #}
    <tr>
        <td class="email-body" style="padding:8px 40px 32px;">

            {% for event in events %}

            <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:28px;">
                <tr>
                    <td>
                        {# Seminar name #}
                        <p style="margin:0 0 6px;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#b25828;">
                            {{ event.seminar.name }}
                        </p>

                        {# Talk title — links to event page #}
                        <h2 class="event-title" style="margin:0 0 8px;font-size:18px;font-weight:700;line-height:1.3;color:#1a1a1a;">
                            <a href="{{ url('app_event_seminar_show', {slug: event.slug}) }}"
                               style="color:#1a1a1a;text-decoration:none;">
                                {{ event.title }}
                            </a>
                        </h2>

                        {# Speaker & institution #}
                        <p style="margin:0 0 10px;font-size:14px;color:#333333;">
                            <strong>{{ event.speaker }}</strong>
                            {% if event.institution %}
                            <span style="color:#888888;">&nbsp;&middot;&nbsp;{{ event.institution }}</span>
                            {% endif %}
                        </p>

                        {# Date / time / location #}
                        <table cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
                            <tr>
                                <td style="font-size:12px;color:#888888;padding-right:16px;white-space:nowrap;">
                                    &#128197;&nbsp;
                                    {{ event.start|format_datetime(pattern="EEEE, d 'de' MMMM", locale='es')|capitalize }}
                                </td>
                                <td style="font-size:12px;color:#888888;padding-right:16px;white-space:nowrap;">
                                    &#128336;&nbsp;
                                    {{ event.start|date('H:i') }} – {{ event.end|date('H:i') }} h
                                </td>
                                <td style="font-size:12px;color:#888888;white-space:nowrap;">
                                    &#128205;&nbsp;{{ event.location }}
                                </td>
                            </tr>
                        </table>

                        {# Abstract #}
                        {% if event.abstract %}
                        <p style="margin:0 0 14px;font-size:13px;line-height:1.7;color:#444444;text-align:justify;">
                            {{ event.abstract|u.truncate(200, '…') }}
                        </p>
                        {% endif %}

                        {# Link to event #}
                        <a href="{{ url('app_event_seminar_show', {slug: event.slug}) }}"
                           style="font-size:12px;font-weight:600;color:#b25828;text-decoration:none;">
                            Ver evento &rarr;
                        </a>
                    </td>
                </tr>
            </table>

            {% if not loop.last %}
            <hr style="border:none;border-top:1px solid #e5e4e2;margin:28px 0 0;">
            {% endif %}

            {% else %}
            <p style="margin:32px 0;font-size:14px;color:#888888;">
                No hay eventos programados para esta semana.
            </p>
            {% endfor %}

        </td>
    </tr>

    {# ── Footer ── #}
    <tr>
        <td style="background:#faf9f8;padding:16px 40px;border-top:1px solid #e5e4e2;">
            <p style="margin:0;font-size:11px;color:#aaaaaa;text-align:center;">
                &copy; {{ "now"|date('Y') }} Centro de Ciencias Matemáticas &middot; UNAM<br>
                <a href="{{ url('app_home') }}" style="color:#b25828;text-decoration:none;">
                    Ver sitio web
                </a>
            </p>
        </td>
    </tr>

</table>
</td></tr>
</table>

</body>
</html>
