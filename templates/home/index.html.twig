{% extends 'base.html.twig' %}

{% block title %}Seminarios CCM - UNAM{% endblock %}

{% block body %}
<div class="container py-5">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <h1 class="mt-3">Seminarios Centro de Ciencias Matemáticas - UNAM</h1>
            <h5 class="mb-4 text-muted">Del {{ startOfWeek|date('j') }} al {{ endOfWeek|date('j \\d\\e F, Y') }}</h5>
        </div>
        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_event_seminar_index') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-ul"></i> Todos los eventos
            </a>
            <a href="{{ path('app_event_seminar_calendario') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-calendar3"></i> Calendario
            </a>
        </div>
    </div>

    {% for event_seminar in event_seminars %}
    <div class="event-card">
        <div class="event-date">
            <div class="event-month">{{ event_seminar.start|date('M') }}</div>
            <div class="event-day">{{ event_seminar.start|date('d') }}</div>
        </div>
        <div class="event-info">
            <div class="event-seminar">{{ event_seminar.seminar.name }}</div>
            <div class="event-title">
                <a href="{{ path('app_event_seminar_show', { slug: event_seminar.slug }) }}" class="event-link">
                    {{ event_seminar.title }}
                </a>
            </div>
            <div class="event-speaker-info d-flex">
                <div class="event-speaker">{{ event_seminar.speaker }}</div>
                <div class="event-university">{{ event_seminar.institution }}</div>
            </div>
            <div class="d-flex">
                <div class="event-time"><i class="bi bi-clock"></i> {{ event_seminar.start|date('H:i') }} horas</div>
                <div class="event-place"><i class="bi bi-geo-alt"></i> {{ event_seminar.location }}</div>
            </div>
        </div>
    </div>
    {% else %}
        <div class="alert alert-warning">
            <h4>No se encontraron eventos programados para esta semana.</h4>
        </div>
    {% endfor %}

</div>
{% endblock %}
