{% extends 'base.html.twig' %}

{% block title %}Seminarios CCM · UNAM{% endblock %}

{% block body %}
<div class="page-wrap">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-4" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="page-header">
        <h1 class="page-title">Seminarios esta semana</h1>
        <p class="page-subtitle">{{ startOfWeek|date('j') }}–{{ endOfWeek|date('j') }} de {{ endOfWeek|format_datetime(pattern="MMMM 'de' yyyy", locale='es') }}</p>
    </div>

    {% for event_seminar in event_seminars %}
    <div class="event-card">
        <div class="event-date">
            <div class="event-month">{{ event_seminar.start|format_datetime(pattern='MMMM', locale='es')|slice(0,3)|upper }}</div>
            <div class="event-day">{{ event_seminar.start|date('d') }}</div>
        </div>
        <div class="event-info">
            <div class="event-seminar">{{ event_seminar.seminar.name }}</div>
            <div class="event-title">
                <a href="{{ path('app_event_seminar_show', { slug: event_seminar.slug }) }}" class="event-link">
                    {{ event_seminar.title }}
                </a>
            </div>
            <div class="event-speaker-info">
                <span class="event-speaker">{{ event_seminar.speaker }}</span>
                <span class="event-university">{{ event_seminar.institution }}</span>
            </div>
            <div class="event-meta">
                <span class="event-time"><i class="bi bi-clock"></i> {{ event_seminar.start|date('H:i') }} h</span>
                <span class="event-place"><i class="bi bi-geo-alt"></i> {{ event_seminar.location }}</span>
            </div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">
        No hay eventos programados para esta semana.
    </div>
    {% endfor %}

    <div class="page-actions">
        <a href="{{ path('app_event_seminar_index') }}" class="action-link">Todos los eventos →</a>
        <a href="{{ path('app_event_seminar_calendario') }}" class="action-link">Calendario →</a>
        <a href="{{ path('app_seminario_index') }}" class="action-link">Seminarios →</a>
    </div>

</div>
{% endblock %}
