{% extends 'base.html.twig' %}

{% block title %}{{ event_seminar.seminar.name }} - {{ event_seminar.title }}{% endblock %}

{% block body %}

    <div class="container p-5">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row">
            <div class="col-12 col-md-9">
                <div class="event-detail-container">
                    <a href="{{ path('app_seminario_show', { slug: event_seminar.seminar.slug }) }}">
                        <div class="event-seminar mb-3">{{ event_seminar.seminar.name }}</div>
                    </a>
                    <h1 class="fw-bold">{{ event_seminar.title }}</h1>
                    <hr class="mb-3">
                    <div class="mb-2"><strong>{{ event_seminar.speaker }}</strong>, {{ event_seminar.institution }}</div>
                    <div class="mb-2"><i class="bi bi-calendar"></i> {{ event_seminar.start|date('F j, H:i') }} - {{ event_seminar.end|date('H:i') }}</div>
                    <div class="mb-2"><i class="bi bi-geo-alt"></i> {{ event_seminar.location }}</div>
                    <hr class="mb-3">
                    <div class="mb-3">
                        {{ event_seminar.abstract }}
                    </div>
                </div>

                {% set calTitle = (event_seminar.seminar.name ~ ': ' ~ event_seminar.title)|url_encode %}
                {% set calDetails = (event_seminar.speaker ~ ' - ' ~ event_seminar.institution ~ '\n\n' ~ event_seminar.abstract)|url_encode %}
                {% set calLocation = event_seminar.location|url_encode %}
                {% set calStart = event_seminar.start|date('Ymd\\THis') %}
                {% set calEnd = event_seminar.end|date('Ymd\\THis') %}

                <div class="d-flex align-items-center gap-3 my-4">
                    <a href="{{ path('app_event_seminar_index') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Regresar a Eventos
                    </a>

                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-calendar-plus"></i> Agregar al Calendario
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="{{ path('event_calendar_export', {slug: event_seminar.slug}) }}">
                                    <i class="bi bi-download"></i> Descargar .ics (Apple / Outlook)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="https://www.google.com/calendar/render?action=TEMPLATE&text={{ calTitle }}&dates={{ calStart }}/{{ calEnd }}&details={{ calDetails }}&location={{ calLocation }}" target="_blank" rel="noopener">
                                    <i class="bi bi-google"></i> Google Calendar
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="https://outlook.live.com/calendar/0/deeplink/compose?subject={{ calTitle }}&body={{ calDetails }}&startdt={{ event_seminar.start|date('c') }}&enddt={{ event_seminar.end|date('c') }}&location={{ calLocation }}" target="_blank" rel="noopener">
                                    <i class="bi bi-microsoft"></i> Outlook Online
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}
