{% extends 'base.html.twig' %}

{% block title %}{{ event_seminar.title }} · CCM{% endblock %}

{% block body %}
<div class="page-wrap">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-4" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="page-header">
        <a href="{{ path('app_seminario_show', { slug: event_seminar.seminar.slug }) }}" class="breadcrumb-link">
            ← {{ event_seminar.seminar.name }}
        </a>
        <h1 class="page-title">{{ event_seminar.title }}</h1>
        <p class="speaker-line">
            <span class="speaker-name">{{ event_seminar.speaker }}</span>
            {% if event_seminar.institution %}
            <span class="speaker-institution">· {{ event_seminar.institution }}</span>
            {% endif %}
        </p>
    </div>

    <div class="event-detail-meta">
        <div class="meta-item">
            <i class="bi bi-calendar3"></i>
            {{ event_seminar.start|format_datetime(pattern="EEEE, d 'de' MMMM 'de' yyyy", locale='es')|capitalize }}
        </div>
        <div class="meta-item">
            <i class="bi bi-clock"></i>
            {{ event_seminar.start|date('H:i') }} – {{ event_seminar.end|date('H:i') }} h
        </div>
        <div class="meta-item">
            <i class="bi bi-geo-alt"></i>
            {{ event_seminar.location }}
        </div>
        {% if event_seminar.url %}
        <div class="meta-item">
            <i class="bi bi-link-45deg"></i>
            <a href="{{ event_seminar.url }}" target="_blank" rel="noopener" style="color: var(--accent);">{{ event_seminar.url }}</a>
        </div>
        {% endif %}
    </div>

    {% if event_seminar.abstract %}
    <div class="abstract-section">
        {{ event_seminar.abstract }}
    </div>
    {% endif %}

    {% if event_seminar.notes %}
    <div class="mt-3" style="font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1rem;">
        {{ event_seminar.notes }}
    </div>
    {% endif %}

    {% set calTitle = (event_seminar.seminar.name ~ ': ' ~ event_seminar.title)|url_encode %}
    {% set calDetails = (event_seminar.speaker ~ ' - ' ~ event_seminar.institution ~ '\n\n' ~ event_seminar.abstract)|url_encode %}
    {% set calLocation = event_seminar.location|url_encode %}
    {% set calStart = event_seminar.start|date('Ymd\\THis') %}
    {% set calEnd = event_seminar.end|date('Ymd\\THis') %}

    <div class="page-actions">
        <a href="{{ path('app_event_seminar_index') }}" class="action-link">← Todos los eventos</a>

        <div class="dropdown">
            <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-calendar-plus"></i> Agregar al calendario
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="{{ path('event_calendar_export', {slug: event_seminar.slug}) }}">
                        <i class="bi bi-download me-1"></i> Descargar .ics (Apple / Outlook)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="https://www.google.com/calendar/render?action=TEMPLATE&text={{ calTitle }}&dates={{ calStart }}/{{ calEnd }}&details={{ calDetails }}&location={{ calLocation }}" target="_blank" rel="noopener">
                        <i class="bi bi-google me-1"></i> Google Calendar
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="https://outlook.live.com/calendar/0/deeplink/compose?subject={{ calTitle }}&body={{ calDetails }}&startdt={{ event_seminar.start|date('c') }}&enddt={{ event_seminar.end|date('c') }}&location={{ calLocation }}" target="_blank" rel="noopener">
                        <i class="bi bi-microsoft me-1"></i> Outlook Online
                    </a>
                </li>
            </ul>
        </div>
    </div>

</div>
{% endblock %}
