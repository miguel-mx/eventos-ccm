{% extends 'base.html.twig' %}

{% block title %}Editar Evento · CCM{% endblock %}

{% block body %}
<div class="page-wrap">

    <div class="page-header">
        <a href="{{ path('app_event_seminar_show', {slug: event_seminar.slug}) }}" class="breadcrumb-link">← {{ event_seminar.title }}</a>
        <h1 class="page-title">Editar evento</h1>
    </div>

    {{ include('event_seminar/_form.html.twig', {'button_label': 'Guardar cambios'}) }}

    <div class="page-actions">
        <a href="{{ path('app_event_seminar_show', {slug: event_seminar.slug}) }}" class="action-link">← Cancelar</a>
        {{ include('event_seminar/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}
