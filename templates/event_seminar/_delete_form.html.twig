<form method="post" action="{{ path('app_event_seminar_delete', {'id': event_seminar.id}) }}" onsubmit="return confirm('¿Eliminar este evento? Esta acción no se puede deshacer.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event_seminar.id) }}">
    <button type="submit" class="btn-link-danger">
        <i class="bi bi-trash3"></i> Eliminar evento
    </button>
</form>
