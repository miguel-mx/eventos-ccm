{% extends 'base.html.twig' %}

{% block title %}Eventos de la semana - CCM{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <script>

        document.addEventListener('DOMContentLoaded', function() {
            let calendarEl = document.getElementById('calendar');
            let calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'listWeek',
                headerToolbar: {
                    left: 'prev,next today',
                    center: '',
                    right: ''
                },
                height: 500, // Fixed height in pixels
                slotMinTime: "08:00:00", // ⬅ Start at 8 AM
                slotMaxTime: "20:00:00", // ⬅ End at 8 PM
                events: '/eventos/consulta/json', // Fetch events from your Symfony API
                eventClick: function(info) {
                    window.open(info.event.extendedProps.url, "_blank"); // Open in a new tab
                    info.jsEvent.preventDefault(); // Prevent default browser behavior
                },
                eventContent: function(arg) {
                    return {
                        html: `<p class="fc-event-title fw-bold">${arg.event.extendedProps.description}</p>
                               <div class="fc-event-info fw-bold">${arg.event.extendedProps.speaker}</div>
                               <div class="fc-event-info">${arg.event.title}</div>`
                    };
                }
            });
            calendar.render();
        });

    </script>

{% endblock %}

{% block body %}
    <div class="container py-5">

    {# read and display all flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <h1 class="mt-5">Seminarios Centro de Ciencias Matemáticas - UNAM</h1>
    <h5 class="mb-5">From {{ startOfWeek|date('F j') }} to {{ endOfWeek|date('F j') }}</h5>

  {#  <div class="event-card">
