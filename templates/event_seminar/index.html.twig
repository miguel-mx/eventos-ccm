    {% for event_seminar in event_seminars %}
    <div class="event-card">
        <div class="event-date">
            <div class="event-month">{{ event_seminar.start|date('M') }}</div>
            <div class="event-day">{{ event_seminar.start|date('d') }}</div>
        </div>
        <div class="event-info">
            <div class="event-seminar">{{ event_seminar.seminar.name }}</div>
            <div class="event-title">
                <a href="{{ path('app_event_seminar_show', { slug: event_seminar.slug }) }}" class="event-link">
                    {{ event_seminar.title }}
                </a>
            </div>
            <div class="event-speaker-info d-flex">
                <div class="event-speaker">{{ event_seminar.speaker}}</div> <div class="event-university">{{ event_seminar.institution }}</div>
            </div>
            <div class="d-flex">
                <div class="event-time"><i class="bi bi-clock"></i> {{ event_seminar.start|date('H:i')}} horas</div><div class="event-place"><i class="bi bi-geo-alt"></i> {{event_seminar.location}}</div>
            </div>
        </div>
    </div>
    {% else %}
        <div class="alert alert-warning">
            <h4 class="">No se encontraron eventos programados para esta semana.</h4>
        </div>
    {% endfor %}

    {# Display pagination controls #}
    <div class="navigation mb-5">
        {{ knp_pagination_render(event_seminars) }}
    </div>


    <div class="row my-5">
        <div class="col-12 col-md-6">
            <div id="calendar"></div>
        </div>
    </div>

