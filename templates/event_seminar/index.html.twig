{% extends 'base.html.twig' %}

{% block title %}Eventos · CCM{% endblock %}

{% block body %}
<div class="page-wrap">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-4" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="page-header">
        <a href="{{ path('app_home') }}" class="breadcrumb-link">← Esta semana</a>
        <div class="page-header-row">
            <h1 class="page-title">Eventos</h1>
            <form method="get" action="{{ path('app_event_seminar_index') }}" class="search-form">
                <div class="search-input-wrap">
                    <i class="bi bi-search search-icon"></i>
                    <input
                        type="search"
                        name="q"
                        value="{{ q }}"
                        placeholder="Título, ponente, institución…"
                        class="search-input"
                    >
                    {% if q %}
                    <a href="{{ path('app_event_seminar_index') }}" class="search-clear" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    {% if q %}
    <p class="search-results-info">
        {{ event_seminars.totalItemCount }} resultado{{ event_seminars.totalItemCount != 1 ? 's' : '' }}
        para <strong>{{ q }}</strong>
    </p>
    {% endif %}

    {% for event_seminar in event_seminars %}
    <div class="event-card">
        <div class="event-date">
            <div class="event-month">{{ event_seminar.start|format_datetime(pattern='MMMM', locale='es')|slice(0,3)|upper }}</div>
            <div class="event-day">{{ event_seminar.start|date('d') }}</div>
        </div>
        <div class="event-info">
            <div class="event-seminar">{{ event_seminar.seminar.name }}</div>
            <div class="event-title">
                <a href="{{ path('app_event_seminar_show', { slug: event_seminar.slug }) }}" class="event-link">
                    {{ event_seminar.title }}
                </a>
            </div>
            <div class="event-speaker-info">
                <span class="event-speaker">{{ event_seminar.speaker }}</span>
                <span class="event-university">{{ event_seminar.institution }}</span>
            </div>
            <div class="event-meta">
                <span class="event-time"><i class="bi bi-clock"></i> {{ event_seminar.start|date('H:i') }} h</span>
                <span class="event-place"><i class="bi bi-geo-alt"></i> {{ event_seminar.location }}</span>
            </div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">
        {% if q %}No se encontraron eventos para <strong>{{ q }}</strong>.
        {% else %}No se encontraron eventos registrados.{% endif %}
    </div>
    {% endfor %}

    <div class="mt-4">
        {{ knp_pagination_render(event_seminars) }}
    </div>

    <div class="page-actions">
        <a href="{{ path('app_home') }}" class="action-link">← Esta semana</a>
        <a href="{{ path('app_event_seminar_calendario') }}" class="action-link">Calendario →</a>
    </div>

</div>
{% endblock %}
