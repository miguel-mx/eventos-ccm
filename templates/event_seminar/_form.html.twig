{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

<div class="form-wrap">

    <p class="form-section-title">Fecha y lugar</p>

    <div class="mb-3">
        {{ form_label(form.location, 'Lugar', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.location) }}
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-4">
            {% if form.start_date is defined %}
                {{ form_label(form.start_date, 'Fecha', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.start_date, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.start_date) }}
            {% endif %}
        </div>
        <div class="col-12 col-sm-4">
            {% if form.start_time is defined %}
                {{ form_label(form.start_time, 'Hora de inicio', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.start_time, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.start_time) }}
            {% endif %}
        </div>
        <div class="col-12 col-sm-4">
            {{ form_label(form.event_duration, 'Duración (h)', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.event_duration, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.event_duration) }}
        </div>
    </div>

    <p class="form-section-title">Información de la plática</p>

    <div class="mb-3">
        {{ form_label(form.title, 'Título', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.title) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.speaker, 'Ponente', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.speaker, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.speaker) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.institution, 'Institución', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.institution, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.institution) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.abstract, 'Resumen', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.abstract, {'attr': {'class': 'form-control', 'rows': 5}}) }}
        {{ form_errors(form.abstract) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.url, 'URL (opcional)', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.url, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.url) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.notes, 'Notas (opcional)', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.notes, {'attr': {'class': 'form-control', 'rows': 2}}) }}
        {{ form_errors(form.notes) }}
    </div>

    <button type="submit" class="btn btn-primary btn-sm px-4">
        {{ button_label|default('Guardar evento') }}
    </button>

</div>

{{ form_end(form) }}
