{% extends 'base.html.twig' %}

{% block title %}New EventSeminar{% endblock %}

{% block body %}
    <div class="container p-5">

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 mb-5">
                <h1>{{ event_seminar.seminar.name }}</h1>
                <div>{{ event_seminar.seminar.organizers|map(o => o.name)|join(', ') }}</div>
