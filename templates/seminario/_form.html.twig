{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

<p class="form-section-title">Información del seminario</p>

<div class="mb-3">
    {{ form_label(form.name, 'Nombre', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.name) }}
</div>

<div class="mb-3">
    {{ form_label(form.location, 'Lugar', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.location) }}
</div>

<div class="mb-4">
    {{ form_label(form.start, 'Hora de inicio', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.start, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.start) }}
</div>

<button type="submit" class="btn btn-primary btn-sm px-4">
    {{ button_label|default('Guardar seminario') }}
</button>

{{ form_end(form) }}
