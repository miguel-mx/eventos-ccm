{% extends 'base.html.twig' %}

{% block title %}{{ seminario.name }} · CCM{% endblock %}

{% block body %}
<div class="page-wrap">

    <div class="page-header">
        <a href="{{ path('app_seminario_index') }}" class="breadcrumb-link">← Seminarios</a>
        <h1 class="page-title">{{ seminario.name }}</h1>
        {% if seminario.organizers|length > 0 %}
        <p class="page-subtitle">{{ seminario.organizers|map(o => o.name)|join(' · ') }}</p>
        {% endif %}
    </div>

    {% if years|length > 1 %}
    <div class="year-filter">
        <a href="{{ path('app_seminario_show', {slug: seminario.slug}) }}"
           class="year-tab {{ selected_year is null ? 'active' : '' }}">Todos</a>
        {% for year in years %}
        <a href="{{ path('app_seminario_show', {slug: seminario.slug, year: year}) }}"
           class="year-tab {{ selected_year == year ? 'active' : '' }}">{{ year }}</a>
        {% endfor %}
    </div>
    {% endif %}

    {% for event in event_seminars %}
    <div class="event-card">
        <div class="event-date">
            <div class="event-month">{{ event.start|format_datetime(pattern='MMMM', locale='es')|slice(0,3)|upper }}</div>
            <div class="event-day">{{ event.start|date('d') }}</div>
        </div>
        <div class="event-info">
            <div class="event-title">
                <a href="{{ path('app_event_seminar_show', { slug: event.slug }) }}" class="event-link">
                    {{ event.title }}
                </a>
            </div>
            <div class="event-speaker-info">
                <span class="event-speaker">{{ event.speaker }}</span>
                <span class="event-university">{{ event.institution }}</span>
            </div>
            <div class="event-meta">
                <span class="event-time"><i class="bi bi-clock"></i> {{ event.start|date('H:i') }} h</span>
                <span class="event-place"><i class="bi bi-geo-alt"></i> {{ event.location }}</span>
            </div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">
        No hay eventos registrados{% if selected_year %} para {{ selected_year }}{% endif %}.
    </div>
    {% endfor %}

    {% if event_seminars.pageCount > 1 %}
    <div class="mt-3">
        {{ knp_pagination_render(event_seminars) }}
    </div>
    {% endif %}

    {% if other_seminarios|length > 0 %}
    <div class="other-seminarios">
        <p class="other-seminarios-title">Otros seminarios</p>
        <ul class="other-seminarios-list">
            {% for s in other_seminarios %}
            <li><a href="{{ path('app_seminario_show', {slug: s.slug}) }}">{{ s }}</a></li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <div class="page-actions">
        <a href="{{ path('app_seminario_index') }}" class="action-link">← Seminarios</a>
        <a href="{{ path('app_home') }}" class="action-link">Esta semana →</a>
    </div>

</div>
{% endblock %}
