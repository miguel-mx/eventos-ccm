    {% for event in seminario.eventSeminars %}
        <div class="event-card">
            <div class="event-date">
                <div class="event-month">{{ event.start|date('M') }}</div>
                <div class="event-day">{{ event.start|date('d') }}</div>
            </div>
            <div class="event-info">
                <div class="event-seminar">{{ event.seminar.name }}</div>
                <div class="event-title">
                    <a href="{{ path('app_event_seminar_show', { slug: event.slug }) }}" class="event-link">
                        {{ event.title }}
                    </a>
                </div>
                <div class="event-speaker-info d-flex">
                    <div class="event-speaker"><strong>{{ event.speaker}}</strong></div> <div class="event-university">{{ event.institution }}</div>
                </div>
                <div class="d-flex">
                    <div class="event-time"><i class="bi bi-clock"></i> {{ event.start|date('H:i')}} horas</div><div class="event-place"><i class="bi bi-geo-alt"></i> {{event.location}}</div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning">
            <h2 class="py-4">No se encontraron eventos programados</h2>
        </div>
    {% endfor %}

