{% extends 'base.html.twig' %}

{% block title %}Editar organizador · CCM{% endblock %}

{% block body %}
<div class="page-wrap">

    <div class="page-header">
        <a href="{{ path('app_organizer_show', {'id': organizer.id}) }}" class="breadcrumb-link">← {{ organizer.name }}</a>
        <h1 class="page-title">Editar organizador</h1>
    </div>

    <div class="form-wrap">
        {{ include('organizer/_form.html.twig', {'button_label': 'Guardar cambios'}) }}
    </div>

    <div class="page-actions">
        <a href="{{ path('app_organizer_show', {'id': organizer.id}) }}" class="action-link">← Cancelar</a>
        {{ include('organizer/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}
