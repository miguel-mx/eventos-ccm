{% extends 'base.html.twig' %}

{% block title %}{{ organizer.name }} · CCM{% endblock %}

{% block body %}
<div class="page-wrap">

    <div class="page-header">
        <a href="{{ path('app_organizer_index') }}" class="breadcrumb-link">← Organizadores</a>
        <h1 class="page-title">{{ organizer.name }}</h1>
        {% if organizer.institution %}
        <p class="page-subtitle">{{ organizer.institution }}</p>
        {% endif %}
    </div>

    <div class="event-detail-meta">
        <div class="meta-item">
            <i class="bi bi-envelope"></i> {{ organizer.email }}
        </div>
        <div class="meta-item">
            <i class="bi bi-mortarboard"></i>
            {% if organizer.seminario %}
                <a href="{{ path('app_seminario_show', {'slug': organizer.seminario.slug}) }}">{{ organizer.seminario }}</a>
            {% else %}
                Sin seminario asignado
            {% endif %}
        </div>
    </div>

    <div class="page-actions">
        <a href="{{ path('app_organizer_index') }}" class="action-link">← Organizadores</a>
        <a href="{{ path('app_organizer_edit', {'id': organizer.id}) }}" class="action-link"><i class="bi bi-pencil"></i> Editar</a>
        {{ include('organizer/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}
