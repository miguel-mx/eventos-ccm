<form method="post" action="{{ path('app_organizer_delete', {'id': organizer.id}) }}" onsubmit="return confirm('¿Eliminar este organizador? Esta acción no se puede deshacer.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ organizer.id) }}">
    <button type="submit" class="btn-link-danger">
        <i class="bi bi-trash3"></i> Eliminar organizador
    </button>
</form>
